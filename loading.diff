+    @staticmethod
+    def _rotate_xy_velocity(points: np.ndarray, start_idx: int,
+                            rotation_t: np.ndarray) -> None:
+        """在给定起始列上对二维速度做旋转（只旋转不平移）。"""
+        velocity = np.zeros((points.shape[0], 3), dtype=np.float32)
+        velocity[:, :2] = points[:, start_idx:start_idx + 2]
+        velocity = velocity @ rotation_t
+        points[:, start_idx:start_idx + 2] = velocity[:, :2]
+
+    def _transform_points_to_lidar(self, points: np.ndarray,
+                                   radar2lidar: np.ndarray) -> np.ndarray:
+        """将雷达坐标系点与速度变换到 LiDAR 坐标系。"""
+        points_homo = np.ones((points.shape[0], 4), dtype=np.float32)
+        points_homo[:, :3] = points[:, :3]
+        points_transformed = points_homo @ radar2lidar.T
+        points[:, :3] = points_transformed[:, :3]
+
+        if self.load_dim >= 10:
+            rotation_t = radar2lidar[:3, :3].T
+            self._rotate_xy_velocity(points, start_idx=6, rotation_t=rotation_t)
+            self._rotate_xy_velocity(points, start_idx=8, rotation_t=rotation_t)
+
+        return points
+
